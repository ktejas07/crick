rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function bootstrapPath() {
      return /databases/$(database)/documents/system/bootstrap;
    }

    function isFirstAdminClaim(uid) {
      return isSignedIn()
        && request.auth.uid == uid
        && !exists(bootstrapPath())
        && getAfter(bootstrapPath()).data.adminUid == uid;
    }

    // Private account data, including email addresses and notifications.
    match /users/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && (request.resource.data.role == 'player'
          || (request.resource.data.role == 'admin' && isFirstAdminClaim(uid)));
      allow update: if isAdmin()
        || (isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoURL', 'photoPath'])
          && request.resource.data.photoURL is string
          && request.resource.data.photoURL.size() <= 350000)
        || (isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notifications']))
        || (isFirstAdminClaim(uid)
          && resource.data.role == 'player'
          && request.resource.data.role == 'admin'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']));
      allow delete: if isAdmin();

      match /notifications/{notificationId} {
        allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly([
            'type', 'title', 'message', 'matchId', 'read', 'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'type', 'title', 'message', 'matchId', 'read', 'createdAt'
          ])
          && request.resource.data.type is string
          && request.resource.data.title is string
          && request.resource.data.message is string
          && request.resource.data.matchId is string
          && request.resource.data.read == false;
        allow update: if isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read is bool;
        allow delete: if false;
      }
    }

    // Public-facing player names and statistics; never store email or notifications here.
    match /players/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'stats', 'createdAt', 'photoURL'])
        && request.resource.data.name is string
        && request.resource.data.stats is map
        && (!request.resource.data.keys().hasAny(['photoURL'])
          || request.resource.data.photoURL == null
          || (request.resource.data.photoURL is string
            && request.resource.data.photoURL.size() <= 350000));
      allow update: if isAdmin()
        || (isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoURL'])
          && request.resource.data.photoURL is string
          && request.resource.data.photoURL.size() <= 350000);
      allow delete: if isAdmin();
    }

    match /system/{document} {
      allow get: if isSignedIn() && document == 'bootstrap';
      allow create: if document == 'bootstrap'
        && isSignedIn()
        && !exists(bootstrapPath())
        && request.resource.data.keys().hasOnly(['adminUid', 'createdAt'])
        && request.resource.data.adminUid == request.auth.uid
        && (isAdmin() || isFirstAdminClaim(request.auth.uid));
      allow update, delete, list: if false;
    }

    match /matches/{matchId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Public score-only projection. The random document ID acts as a share code.
    match /publicMatches/{shareCode} {
      allow get: if shareCode.matches('^[A-HJ-NP-Z2-9]{12}$');
      allow list: if false;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'matchId', 'title', 'venue', 'overs', 'status', 'teamA', 'teamB', 'innings', 'toss', 'result'
        ])
        && request.resource.data.matchId is string
        && request.resource.data.status in ['scheduled', 'toss', 'innings1', 'innings2', 'completed'];
      allow delete: if isAdmin();
    }
  }
}
