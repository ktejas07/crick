rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function bootstrapPath() {
      return /databases/$(database)/documents/system/bootstrap;
    }

    function isFirstAdminClaim(uid) {
      return isSignedIn()
        && request.auth.uid == uid
        && !exists(bootstrapPath())
        && getAfter(bootstrapPath()).data.adminUid == uid;
    }

    // Private account data, including email addresses and notifications.
    match /users/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && (request.resource.data.role == 'player'
          || (request.resource.data.role == 'admin' && isFirstAdminClaim(uid)));
      allow update: if isAdmin()
        || (isFirstAdminClaim(uid)
          && resource.data.role == 'player'
          && request.resource.data.role == 'admin'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']));
      allow delete: if isAdmin();
    }

    // Public-facing player names and statistics; never store email or notifications here.
    match /players/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'stats', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.stats is map;
      allow update, delete: if isAdmin();
    }

    match /system/{document} {
      allow get: if isSignedIn() && document == 'bootstrap';
      allow create: if document == 'bootstrap'
        && isSignedIn()
        && !exists(bootstrapPath())
        && request.resource.data.keys().hasOnly(['adminUid', 'createdAt'])
        && request.resource.data.adminUid == request.auth.uid
        && (isAdmin() || isFirstAdminClaim(request.auth.uid));
      allow update, delete, list: if false;
    }

    match /matches/{matchId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}

